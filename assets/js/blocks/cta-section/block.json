{
  "apiVersion": 3,
  "name": "greensun-hotel/cta-section",
  "title": "CTA Section",
  "category": "design",
  "icon": "megaphone",
  "description": "Full-width call-to-action with background image, eyebrow, title, subtitle and button.",
  "editorScript": "file:./build/index.js",
  "style": "file:./style.css",
  "render": "file:./render.php",
  "attributes": {
    "eyebrow":       { "type": "string", "default": "Reserve your stay" },
    "title":         { "type": "string", "default": "A room is waiting <em>for you.</em>" },
    "subtitle":      { "type": "string", "default": "Direct booking, best available rates. Reach our team for tailored stays, long-term bookings, and event packages." },
    "ctaText":       { "type": "string", "default": "Book a room" },
    "ctaUrl":        { "type": "string", "default": "/booking" },
    "secondaryCtaText": { "type": "string", "default": "Talk to our team" },
    "secondaryCtaUrl":  { "type": "string", "default": "/contact" },
    "imageUrl":      { "type": "string", "default": "" },
    "imageId":       { "type": "number", "default": 0 },
    "imageAlt":      { "type": "string", "default": "" },
    "overlayOpacity":{ "type": "number", "default": 70 },
    "layout":        { "type": "string", "default": "centered" }
  }
}
