{
  "apiVersion": 3,
  "name": "greensun-hotel/events-teaser",
  "title": "Events Teaser",
  "category": "design",
  "icon": "calendar-alt",
  "description": "Featured upcoming events pulled from the Event CPT.",
  "editorScript": "file:./build/index.js",
  "style": "file:./style.css",
  "render": "file:./render.php",
  "attributes": {
    "eyebrow":       { "type": "string", "default": "What's on" },
    "sectionTitle":  { "type": "string", "default": "Seasonal <em>gatherings</em>." },
    "subtitle":      { "type": "string", "default": "Harvest dinners, foraging walks, and live evenings on the terrace." },
    "ctaText":       { "type": "string", "default": "All events" },
    "ctaUrl":        { "type": "string", "default": "/events" },
    "featuredEvents":{ "type": "array",  "default": [] },
    "fallbackCount": { "type": "number", "default": 3 }
  }
}
