{
  "apiVersion": 3,
  "name": "greensun-hotel/team-grid",
  "title": "Team Grid",
  "category": "design",
  "icon": "groups",
  "description": "Grid of team members with portrait, name and role.",
  "editorScript": "file:./build/index.js",
  "style": "file:./style.css",
  "render": "file:./render.php",
  "attributes": {
    "eyebrow":      { "type": "string", "default": "The team" },
    "sectionTitle": { "type": "string", "default": "Familiar faces at <em>the front desk.</em>" },
    "columns":      { "type": "number", "default": 4 },
    "members": {
      "type": "array",
      "default": [
        { "imageUrl": "", "imageId": 0, "imageAlt": "", "name": "Rina",  "role": "General manager"           },
        { "imageUrl": "", "imageId": 0, "imageAlt": "", "name": "Marco", "role": "Head of guest experience"  },
        { "imageUrl": "", "imageId": 0, "imageAlt": "", "name": "Lia",   "role": "Events director"           },
        { "imageUrl": "", "imageId": 0, "imageAlt": "", "name": "Tom",   "role": "Executive chef"            }
      ]
    }
  }
}
