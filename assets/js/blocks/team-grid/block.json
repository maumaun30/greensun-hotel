    "members": {
      "type": "array",
      "default": [
        { "imageUrl": "", "imageId": 0, "imageAlt": "", "name": "Imogen Hart", "role": "Innkeeper" },
        { "imageUrl": "", "imageId": 0, "imageAlt": "", "name": "Marco Riu",   "role": "Head chef"  },
        { "imageUrl": "", "imageId": 0, "imageAlt": "", "name": "Eli Park",    "role": "Sommelier"  }
      ]
    }
  }
}
