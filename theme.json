{
  "$schema": "https://schemas.wp.org/trunk/theme.json",
  "version": 3,
  "settings": {
    "appearanceTools": true,
    "layout": {
      "contentSize": "840px",
      "wideSize": "1200px"
    },
    "spacing": {
      "units": ["px", "rem", "em", "%", "vw", "vh"]
    },
    "typography": {
      "fluid": true,
      "fontFamilies": [
        {
          "slug": "display",
          "name": "Roca Two (Display)",
          "fontFamily": "\"Roca Two\", \"Cormorant Garamond\", Georgia, serif"
        },
        {
          "slug": "sans",
          "name": "Codec Pro (Body)",
          "fontFamily": "\"Codec Pro\", ui-sans-serif, system-ui, sans-serif"
        }
      ]
    },
    "color": {
      "palette": [
        { "slug": "forest", "name": "Forest", "color": "#5a7755" },
        { "slug": "forest-dark", "name": "Forest Dark", "color": "#3f5a3b" },
        { "slug": "sun", "name": "Sun", "color": "#e8c46a" },
        { "slug": "ivory", "name": "Ivory", "color": "#fbf7ec" },
        { "slug": "ink", "name": "Ink", "color": "#403e3f" },
        { "slug": "line", "name": "Line", "color": "#e6e1d6" },
        { "slug": "white", "name": "White", "color": "#FFFFFF" }
      ]
    }
  },
  "styles": {
    "color": {
      "background": "#fbf7ec",
      "text": "#403e3f"
    },
    "typography": {
      "fontFamily": "\"Codec Pro\", ui-sans-serif, system-ui, sans-serif",
      "lineHeight": "1.6"
    },
    "spacing": {
      "blockGap": "1.5rem"
    }
  }
}
